DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CONTROL_PLANE_URL=http://control:8000
